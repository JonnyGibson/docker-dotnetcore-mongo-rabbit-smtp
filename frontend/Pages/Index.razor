@page "/"
@using frontend.Data
@using System.Net.Http
@using System.Net.Http.Json
@inject RecipientService _recipientService
@inject IJSRuntime JsRuntime
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Book Recommendations</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Step 1: Add Recipients</h2>
            @if (showInput)
            {
                <EditForm Model="@newRecipient" OnValidSubmit="@AddNew">
                    <div class="input-group mb-3 w-50">
                        <input id="new-recipient" type="text" class="form-control" 
                               @bind="newRecipient.Email" 
                               @bind:event="oninput" 
                               placeholder="Recipient's Email" 
                               aria-label="Recipient's Email" 
                               aria-describedby="basic-addon2"/> 
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="submit">Add</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleAddNew">Cancel</button>
                        </div>   
                    </div>
                    <ValidationMessage For="@(() => newRecipient.Email)" />
                    <DataAnnotationsValidator />
                </EditForm>
            } 
            else 
            {
                <button class="btn btn-success mt-1" id="btn-add-new" @onclick="ToggleAddNew">
                    <i class="bi bi-plus"></i> Add Recipient
                </button>
            }

            @if (recipients?.Any() == true)
            {
                <ul class="list-group w-50 mt-3">
                    @foreach (var recipient in recipients)
                    {
                        <li class="list-group-item">@recipient.Email</li>
                    }
                </ul>
                <button class="btn btn-danger mt-1" @onclick="Clear">
                    <i class="bi bi-trash"></i> Clear Recipients
                </button>
            }
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Queue Status</h5>
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" @onclick="RefreshQueueStatus">
                        <i class="bi bi-arrow-clockwise me-0"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (queueStatus == null)
                    {
                        <p>Loading queue status...</p>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-8">Messages in Queue:</dt>
                            <dd class="col-sm-4">@queueStatus.MessageCount</dd>
                        </dl>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <h2>Step 2: Send Recommendations</h2>
            <div class="mt-3 mb-3">
                <label for="recommendationCount">Number of Recommendations:</label>
                <select id="recommendationCount" @bind="selectedCount" class="form-control w-25">
                    <option value="1">1</option>
                    <option value="3">3</option>
                    <option value="5">5</option>
                    <option value="10">10</option>
                </select>
                <button class="btn btn-primary mt-2" @onclick="SendRecommendations">Send Recommendations</button>
            </div>
        </div>
    </div>
</div>

@code {
    private Recipient newRecipient = new();
    private Recipient[]? recipients;
    private bool showInput;
    private int selectedCount = 1;
    private QueueStatus? queueStatus;

    private class QueueStatus
    {
        public int MessageCount { get; set; }
    }

    private async Task RefreshList()
    {
        recipients = await _recipientService.GetRecipientsAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (showInput)
            {
                await JsRuntime.InvokeVoidAsync("MySetFocus", "new-recipient");
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("MySetFocus", "btn-add-new");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
        await RefreshQueueStatus();
    }

    private void ToggleAddNew()
    {
        showInput = !showInput;
    }

    private async Task AddNew()
    {
        _recipientService.AddRecipient(newRecipient.Email);
        await RefreshList();
        ToggleAddNew();
        newRecipient = new();
    }

    private async Task Clear()
    {
        _recipientService.Clear();
        await RefreshList();
    }

    private async Task RefreshQueueStatus()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BookRecommenderAPI");
            queueStatus = await client.GetFromJsonAsync<QueueStatus>("api/Queue/Status");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching queue status: {ex.Message}");
            queueStatus = null;
        }
    }

    private async Task SendRecommendations()
    {
        try
        {
            if (recipients == null || !recipients.Any())
            {
                await JsRuntime.InvokeVoidAsync("alert", "Please add at least one recipient email address.");
                return;
            }

            var client = HttpClientFactory.CreateClient("BookRecommenderAPI");
            var request = new
            {
                Count = selectedCount,
                Recipients = recipients.Select(r => r.Email).ToList()
            };
            
            var response = await client.PostAsJsonAsync("api/Recomendation", request);
            
            if (response.IsSuccessStatusCode)
            {
                await JsRuntime.InvokeVoidAsync("alert", $"Successfully sent {selectedCount} recommendations to {recipients.Length} recipients.");
                await RefreshQueueStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"Failed to send recommendations: {error}");
                Console.WriteLine($"Failed to send recommendations: {error}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error sending recommendations: {ex.Message}");
            Console.WriteLine($"Error sending recommendations: {ex.Message}");
        }
    }
}